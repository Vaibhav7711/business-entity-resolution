{
  "backbone": "intfloat/multilingual-e5-small",
  "allowed_licenses": [
    "mit",
    "apache-2.0"
  ],
  "prefix": "query: ",
  "max_length": 64,
  "train_folds": [
    1,
    2,
    3,
    4
  ],
  "max_pairs": 2000000,
  "batch_size": 256,
  "temperature": 0.05,
  "lr": 3e-05,
  "warmup": 0.05,
  "weight_decay": 0.01,
  "train_minutes": 45,
  "seed": 20260927,
  "log_every": 100,
  "embed_batch": 1024,
  "top_k": 50,
  "search_query_block": 1024,
  "search_target_chunk": 1048576,
  "part_rows": 1000000,
  "purpose": "Dense lists for the fold-0 training S1 only, from the already trained bi-encoder (attach its output): training data for a cross-encoder that sees the dense route's candidates.",
  "labelled_splits": [
    "train"
  ],
  "retrieve_test": false
}
